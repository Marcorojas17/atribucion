# ─────────────────────────────────────────────────────────────
# ATRIBUCIÓN — CONFIGURACIÓN DE EJEMPLO
# ─────────────────────────────────────────────────────────────
# Copia este archivo a .env y rellena los valores.
# NUNCA subas .env a git. Solo .env.example.

# ─────────────────────────────────────────────────────────────
# ENTORNO
# ─────────────────────────────────────────────────────────────
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000
API_SECRET_KEY=genera-una-clave-aleatoria-de-32-bytes

# ─────────────────────────────────────────────────────────────
# ETHEREUM — SEPOLIA (TESTNET)
# ─────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://rpc.sepolia.org
SEPOLIA_CHAIN_ID=11155111

# NUNCA compartir. NUNCA subir a git.
SEPOLIA_PRIVATE_KEY=

# Dirección pública (esta sí es pública)
DEPLOYER_ADDRESS=

# Dirección del contrato (se llena tras el deploy)
ANCHOR_CONTRACT_ADDRESS=

# ─────────────────────────────────────────────────────────────
# ETHEREUM — MAINNET (PRODUCCIÓN)
# ─────────────────────────────────────────────────────────────
MAINNET_RPC_URL=
MAINNET_CHAIN_ID=1
MAINNET_PRIVATE_KEY=
MAINNET_ANCHOR_CONTRACT_ADDRESS=

# ─────────────────────────────────────────────────────────────
# IPFS
# ─────────────────────────────────────────────────────────────
IPFS_GATEWAY=https://ipfs.io
IPFS_API_URL=
IPFS_API_KEY=

# Arweave (archivo permanente)
ARWEAVE_WALLET_PATH=
ARWEAVE_HOST=https://arweave.net

# ─────────────────────────────────────────────────────────────
# TSA — SELLADO DE TIEMPO
# ─────────────────────────────────────────────────────────────
TSA_URL=https://freetsa.org/tsr
TSA_USERNAME=
TSA_PASSWORD=
TSA_MODE=mock

# ─────────────────────────────────────────────────────────────
# MERCADO PAGO
# ─────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true

# ─────────────────────────────────────────────────────────────
# POSTGRESQL (persistencia)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/atribucion
DATABASE_POOL_SIZE=10

# ─────────────────────────────────────────────────────────────
# REDIS (caché + rate limiting)
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────
# MONITOREO
# ─────────────────────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# ─────────────────────────────────────────────────────────────
# EMAIL (notificaciones)
# ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@atribucion.io

# ─────────────────────────────────────────────────────────────
# LEGAL / COMPLIANCE
# ─────────────────────────────────────────────────────────────
LEGAL_ENTITY_NAME=Atribución
LEGAL_JURISDICTION=MX
GDPR_ENABLED=true
EU_AI_ACT_ENABLED=true